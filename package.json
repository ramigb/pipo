{
  "name": "pipo",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "bun scripts/test.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome format --write .",
    "ui-shots": "bun scripts/ui-shots.ts",
    "site": "bun scripts/serve-site.ts",
    "verify": "bun run build:runner && bun run test:runner && cargo clippy -p pipo-runner --all-targets -- -D warnings && bun run typecheck && bun run lint && bun run test",
    "schema": "bun packages/cli/src/main.ts schema > schema/pipo.schema.json",
    "coverage": "bun scripts/phase1-coverage.ts",
    "stress": "bun scripts/stress.ts",
    "pipo": "bun packages/cli/src/main.ts",
    "build:runner": "cargo build --release -p pipo-runner",
    "test:runner": "cargo test -p pipo-runner",
    "postinstall": "bun scripts/build-runner.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
