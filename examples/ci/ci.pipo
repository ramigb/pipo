# CI for the shop API in ./app: every push to main is checked out and tested. A green build is built and handed to
# the deploy pipeline, and its packet is delivered only once that commit is live in production. A red build goes to
# Claude Code, which fixes it in the build's workspace; the tests run again (two more tries at most), and the fix is
# pushed to a branch, autofix/<short>, for a person to review. See README.md; docs/spec.md §3.3.1, §3.4, §3.14.
#   export CI_WEBHOOK_SECRET=$(openssl rand -hex 20)
#   bun pipo start examples/deploy/deploy.pipo && bun pipo start examples/ci/ci.pipo
#   bun examples/ci/demo.ts init        # a local repository whose commits send GitHub push events here
pipo: 1
name: ci
description: Test every push to main, deploy green builds, and have Claude Code fix red ones on a branch.

fn: ./ci.fn.ts

secrets:
  webhook: env:CI_WEBHOOK_SECRET

# One build at a time, in push order, so main reaches production in the order it was pushed.
concurrency: 1

errors:
  retry: 1
  delay: 2s
  then: dead_letter

inputs:
  # A GitHub webhook (content type application/json, push events), signed with the shared secret.
  github:
    via: http
    with:
      path: /github
      listen: 8793
      auth:
        hmac: {header: X-Hub-Signature-256, secret: "${secrets.webhook}", algorithm: sha256}
    format: json
    validate:
      - type(data.ref) == "string" || exists(data.zen)
    on_invalid:
      respond: 422
      message: "Not a GitHub push event: rule '${error.rule}' failed."

  # Build any commit again: pipo push ci --input manual --data '{"repo": "…", "sha": "…"}'
  manual:
    via: push
    validate:
      - type(data.repo) == "string"
      - type(data.sha) == "string" && matches(data.sha, "^[0-9a-f]{40}$")

nodes:
  event:
    label: Read the push
    from: github
    transform: fn.fromPush

  main:
    label: main only
    from: [event, manual]
    filter: exists(data.sha) && default(data.branch, "main") == "main"

  checkout:
    label: Check out
    from: main
    transform: exec
    with:
      command: bun
      args: [./steps/checkout.ts, "${meta.packet_id}"]
      stdin: "${json(data)}"
      result: json
      timeout: 2m

  test:
    label: bun test
    from: checkout
    transform: exec
    with:
      command: bun
      args: [./steps/test.ts, "${meta.packet_id}"]
      stdin: "${json(data)}"
      result: json
      timeout: 5m

  verdict:
    from: test
    route:
      green: data.tests.ok
      red: else

  # Green: build the release artifact, out/artifacts/<sha>/app.js.
  build:
    label: bun build
    from: verdict.green
    tap: exec
    with:
      command: bun
      args: [build, ./src/app.ts, --target, bun, --outfile, "${data.artifact}/app.js"]
      cwd: "${data.workspace}"
      outputs: ["${data.artifact}/app.js"]
      timeout: 2m
    on_error: {then: dead_letter}

  # Red: Claude Code works in the build's own checkout, with its tools on, and answers in fix.schema.json's shape.
  fix:
    label: Claude Code fixes it
    from: verdict.red
    agent: claude_code
    with:
      model: sonnet
      cwd: "${data.workspace}"
      allow_tools: true
      timeout: 10m
      schema: ./fix.schema.json
      prompt: |
        The tests fail on main at commit ${data.short} ("${data.message}" by ${data.author}).
        You are in a checkout of that commit. `bun test` says:

        ${data.tests.log}
        ${meta.iteration > 0 ? "Your last change did not make them pass; the output above is from after it." : ""}
        Find the cause and fix it with the smallest change that makes `bun test` pass. Fix the code, not the
        tests, unless a test is plainly wrong. Run `bun test` to check. Don't commit, push or change git settings.
    on_error: {retry: 0, then: dead_letter}

  retest:
    label: bun test again
    from: fix
    transform: exec
    with:
      command: bun
      args: [./steps/test.ts, "${meta.packet_id}", --after-fix, "${meta.iteration}"]
      stdin: "${json(data)}"
      result: json
      timeout: 5m
    # Still red: back to Claude Code with the new output, twice at most; then a person has to look (the DLQ).
    loop:
      back_to: fix
      until: data.tests.ok
      max: 2
      then: dead_letter

  propose:
    label: Push autofix branch
    from: retest
    tap: exec
    with:
      command: bun
      args: [./steps/propose.ts]
      stdin: "${json(data)}"
      timeout: 1m

  # Only a commit that passed as pushed is deployed. A fixed one ends here, filtered, with its branch pushed.
  ship:
    from: [build, propose]
    filter: data.status == "passed"

output:
  from: ship
  to: pipeline
  with:
    pipeline: deploy
    data:
      sha: "${data.sha}"
      short: "${data.short}"
      message: "${data.message}"
      author: "${data.author}"
  on_error: {retry: 10, backoff: exponential, delay: 1s, max_delay: 30s}

# The commit counts as delivered only when deploy has verified it live, so `pipo packets ci` reads as a deploy log.
delivered:
  check: downstream
  within: 2m
  on_fail:
    then: dead_letter
    message: "${data.short} passed CI but did not go live: ${error.message}"
  stall:
    after: 15m
    then: notify
    message: "CI is stuck: ${stall.pending} builds waiting, the oldest at '${stall.oldest.node}' for ${stall.oldest.age}."

# Claude Code reports what each fix costs.
agent_budget:
  per_day: 5.00
  warn_at: 80%
